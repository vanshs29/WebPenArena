<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard — Ashwell</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
<div class="container mt-5" style="max-width:640px">
  <h1 class="mb-4">Dashboard</h1>
  <p class="text-muted">Signed in as <%= user.username %> (<%= user.email %>)</p>
  <% if (userCase) { %>
    <a class="list-group-item list-group-item-action" href="/case/<%= userCase.id %>">
      Case <%= userCase.case_number %>
    </a>
  <% } %>
</div>
</body>
</html>
