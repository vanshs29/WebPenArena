<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Case <%= caseRow.case_number %> — Ashwell</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
<div class="container mt-5" style="max-width:640px">
  <h1 class="mb-4">Case <%= caseRow.case_number %></h1>
  <p>
    Last compiled:
    <% if (caseRow.last_compiled_at) { %>
      <%= new Date(caseRow.last_compiled_at * 1000).toISOString() %>
    <% } else { %>
      not yet compiled
    <% } %>
  </p>
  <h2 class="h5 mt-4">Supporting documents</h2>
  <p class="text-muted">Upload receipts, photos, and correspondence for this case.</p>
  <form id="upload-form">
    <div class="mb-3">
      <label class="form-label" for="filename">Filename</label>
      <input class="form-control" type="text" id="filename" name="filename" required>
    </div>
    <div class="mb-3">
      <label class="form-label" for="content">Content</label>
      <textarea class="form-control" id="content" name="content"></textarea>
    </div>
    <button class="btn btn-primary" type="submit">Upload</button>
  </form>
  <p class="mt-3"><a href="/case/<%= caseRow.id %>/documents">View uploaded documents (JSON)</a></p>
</div>
</body>
</html>
