<h1 class="h3 mb-4">Incident History</h1>

<% if (incidents.length === 0) { %>
  <p class="text-muted">No incidents recorded for your organization yet.</p>
<% } else { %>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>Title</th>
          <th>Severity</th>
          <th>Status</th>
          <th>Occurred</th>
        </tr>
      </thead>
      <tbody>
        <% incidents.forEach((incident) => { %>
          <tr>
            <td>
              <%= incident.title %>
              <% if (incident.isPlatformWide) { %>
                <span class="badge bg-secondary ms-1">Platform-wide</span>
              <% } %>
            </td>
            <td><span class="badge mdn-badge-<%= incident.severity %>"><%= incident.severity %></span></td>
            <td><span class="badge mdn-badge-resolved"><%= incident.status %></span></td>
            <td><%= new Date(incident.occurredAt).toISOString().slice(0, 10) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
