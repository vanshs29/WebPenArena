<h1 class="h3 mb-4">Team Roster</h1>

<div class="table-responsive mb-4">
  <table class="table align-middle">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
      </tr>
    </thead>
    <tbody>
      <% roster.forEach((m) => { %>
        <tr>
          <td><%= m.name %></td>
          <td><%= m.email %></td>
          <td><span class="badge bg-light text-dark"><%= m.role %></span></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="mdn-card p-4">
  <h2 class="h5">Your API Keys</h2>
  <p class="text-muted">Personal API keys authenticate your own requests against the Meridian Partner API.</p>
  <table class="table align-middle mb-0" id="api-keys-table">
    <thead>
      <tr><th>Label</th><th>Key</th></tr>
    </thead>
    <tbody id="api-keys-body">
      <tr><td colspan="2" class="text-muted">Loading…</td></tr>
    </tbody>
  </table>
</div>

<script>
const MY_API_KEYS_QUERY = `query MyApiKeys {
  me {
    id
    name
    email
    apiKeys {
      id
      label
      key
    }
  }
}`;

fetch('/graphql', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({ query: MY_API_KEYS_QUERY }),
})
  .then((r) => r.json())
  .then((result) => {
    const body = document.getElementById('api-keys-body');
    const keys = (result.data && result.data.me && result.data.me.apiKeys) || [];
    if (keys.length === 0) {
      body.innerHTML = '<tr><td colspan="2" class="text-muted">No API keys issued yet.</td></tr>';
      return;
    }
    body.innerHTML = keys
      .map((k) => `<tr><td>${k.label}</td><td class="mdn-secret">${k.key}</td></tr>`)
      .join('');
  })
  .catch(() => {
    document.getElementById('api-keys-body').innerHTML =
      '<tr><td colspan="2" class="text-muted">Unable to load API keys.</td></tr>';
  });
</script>
