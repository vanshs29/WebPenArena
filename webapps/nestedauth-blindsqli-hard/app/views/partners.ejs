<h1 class="h3 mb-4">Partner Directory</h1>
<p class="text-muted">Organizations on the Meridian platform.</p>

<ul class="list-group" id="partners-list">
  <li class="list-group-item text-muted">Loading…</li>
</ul>

<script>
const DIRECTORY_QUERY = `query PartnerDirectory {
  organizationDirectory {
    id
    name
  }
}`;

fetch('/graphql', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({ query: DIRECTORY_QUERY }),
})
  .then((r) => r.json())
  .then((result) => {
    const list = document.getElementById('partners-list');
    const orgs = (result.data && result.data.organizationDirectory) || [];
    list.innerHTML = orgs.map((o) => `<li class="list-group-item">${o.name}</li>`).join('');
  })
  .catch(() => {
    document.getElementById('partners-list').innerHTML =
      '<li class="list-group-item text-muted">Unable to load partner directory.</li>';
  });
</script>
