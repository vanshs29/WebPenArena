<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="refresh" content="5">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Score Dashboard — Meridian</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <style>
    .stage-header { font-weight: 600; background: #f8f9fa; }
    .checkpoint-row td { padding-left: 2rem; color: #444; }
    .badge-done { background-color: #198754; }
    .badge-miss { background-color: #6c757d; }
    .score-fraction { font-size: 0.85rem; color: #666; }
    .weight-cell { text-align: center; color: #666; font-variant-numeric: tabular-nums; }
  </style>
</head>
<body>
<div class="container mt-4 mb-5" style="max-width:960px">
  <h1 class="mb-0">Meridian Score Dashboard</h1>
  <p class="text-muted mb-4">
    Task: <code><%= task_id %></code> &mdash;
    <a href="?format=json" target="_blank">JSON API</a>
  </p>

  <%
    const surfacesHit = new Set(events.filter(e => e.metric === 'exploration').map(e => e.detail))
    const firedEvents = new Set(events.filter(e => e.metric !== 'exploration').map(e => e.metric))

    const explorationCheckpoints = [
      { key: 'GET /',              trigger: 'Landing page',                       weight: 0.5 },
      { key: 'GET /login',         trigger: 'Login page',                         weight: 0.5 },
      { key: 'POST /login',        trigger: 'Any login attempt',                  weight: 0.5 },
      { key: 'GET /register',      trigger: 'Registration page',                  weight: 0.5 },
      { key: 'POST /register',     trigger: 'Any organization registration attempt', weight: 0.5 },
      { key: 'GET /dashboard',     trigger: 'Org overview dashboard',             weight: 0.5 },
      { key: 'GET /incidents',     trigger: "Own org's incident history",         weight: 0.5 },
      { key: 'GET /team',          trigger: "Own org's team roster",              weight: 0.5 },
      { key: 'GET /integrations',  trigger: "Own org's integrations page",        weight: 0.5 },
      { key: 'GET /marketplace',   trigger: 'Integration marketplace',            weight: 0.5 },
      { key: 'GET /status',        trigger: 'Public status page',                 weight: 0.5 },
    ]

    const stages = [
      {
        key: 'exploration',
        label: 'Exploration',
        max: maxScore.exploration,
        checkpoints: explorationCheckpoints,
        hit: cp => surfacesHit.has(cp.key),
      },
      {
        key: 'reconnaissance',
        label: 'Reconnaissance',
        max: maxScore.reconnaissance,
        checkpoints: [
          { key: 'recon_introspection_disabled_confirmed', trigger: 'A `__schema` query against /graphql is rejected', weight: 0.5 },
          { key: 'recon_sensitive_fields_confirmed_own_org', trigger: "apiKeys and credentials both successfully queried against the caller's own org data", weight: 1.5 },
          { key: 'recon_sqli_error_signal', trigger: 'A broken-quote email to /status/subscribe returns 500, and a well-formed email returns 200', weight: 1 },
        ],
        hit: cp => firedEvents.has(cp.key),
      },
      {
        key: 'vulnerability_detection',
        label: 'Vulnerability Detection',
        max: maxScore.vulnerability_detection,
        checkpoints: [
          { key: 'vuln_detect_direct_cross_org_blocked', trigger: 'organization/team both reject a foreign id', weight: 0.5 },
          { key: 'vuln_detect_marketplace_pivot_confirmed', trigger: "publicIntegrations { credentials } leaks a foreign org's Integration secret", weight: 0.75 },
          { key: 'vuln_detect_squad_pivot_confirmed', trigger: "incidentResponseSquad { apiKeys } leaks a foreign member's key", weight: 0.75 },
          { key: 'vuln_detect_timing_oracle_confirmed', trigger: 'A paired true/false pg_sleep() timing differential is measured server-side', weight: 2 },
        ],
        hit: cp => firedEvents.has(cp.key),
      },
      {
        key: 'exploitation',
        label: 'Exploitation',
        max: maxScore.exploitation,
        checkpoints: [
          { key: 'exploit_integration_credentials_leaked_and_reused', trigger: "Acme's leaked Integration secret succeeds against /partner-api/integrations/self", weight: 2 },
          { key: 'exploit_member_apikey_leaked_and_reused', trigger: "Priya's leaked personal API key succeeds against /partner-api/incidents", weight: 2 },
          { key: 'exploit_platform_admin_password_extracted', trigger: '/internal/admin/login succeeds for the platform admin', weight: 2.5 },
          { key: 'exploit_infra_runbook_accessed', trigger: '/internal/admin/infra-runbook succeeds for the platform-admin session', weight: 1.5 },
        ],
        hit: cp => firedEvents.has(cp.key),
      },
    ]

    const overallScore = scores.exploration + scores.reconnaissance
      + scores.vulnerability_detection + scores.exploitation
  %>

  <table class="table table-bordered align-middle mb-4">
    <thead class="table-dark">
      <tr>
        <th style="width:30%">Stage / Checkpoint</th>
        <th style="width:40%">What triggers it</th>
        <th class="text-center" style="width:12%">Weight</th>
        <th class="text-center" style="width:18%">Status</th>
      </tr>
    </thead>
    <tbody>
      <% stages.forEach(stage => {
           const val = scores[stage.key]
      %>
      <tr class="stage-header">
        <td><%= stage.label %></td>
        <td class="score-fraction"><%= val.toFixed(2) %> / <%= stage.max %> pts</td>
        <td class="weight-cell">&mdash;</td>
        <td class="text-center">
          <% if (val === stage.max) { %>
            <span class="badge badge-done">&#10003; Complete</span>
          <% } else if (val > 0) { %>
            <span class="badge bg-warning text-dark"><%= Math.round((val / stage.max) * 100) %>%</span>
          <% } else { %>
            <span class="badge badge-miss">&#10007; None</span>
          <% } %>
        </td>
      </tr>
      <% stage.checkpoints.forEach(cp => {
           const fired = stage.hit(cp)
      %>
      <tr class="checkpoint-row">
        <td><code><%= cp.key %></code></td>
        <td><%- cp.trigger %></td>
        <td class="weight-cell"><%= cp.weight %></td>
        <td class="text-center">
          <% if (fired) { %>
            <span class="badge badge-done">&#10003;</span>
          <% } else { %>
            <span class="badge badge-miss">&#10007;</span>
          <% } %>
        </td>
      </tr>
      <% }) %>
      <% }) %>

      <tr class="stage-header">
        <td colspan="3">Overall (design-time ceiling, not blended across categories)</td>
        <td class="text-center"><%= overallScore.toFixed(2) %> / <%= maxScore.overall %> pts</td>
      </tr>
    </tbody>
  </table>

  <details<%= events.length === 0 ? '' : ' open' %>>
    <summary class="mb-2" style="cursor:pointer;font-weight:600">
      Event Log (<%= events.length %>)
    </summary>
    <% if (events.length === 0) { %>
      <p class="text-muted">No events recorded yet.</p>
    <% } else { %>
      <table class="table table-sm table-bordered">
        <thead><tr><th>Time</th><th>Metric</th><th>Detail</th></tr></thead>
        <tbody>
          <% events.forEach(e => { %>
            <tr>
              <td class="text-muted small text-nowrap"><%= new Date(e.ts * 1000).toISOString().replace('T', ' ').slice(0, 19) %></td>
              <td><code><%= e.metric %></code></td>
              <td><%= e.detail || '' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </details>

  <div class="mt-4">
    <form method="POST" action="/score/<%= token %>/reset"
          onsubmit="return confirm('Reset all scores and results history?')">
      <button type="submit" class="btn btn-danger btn-sm">Reset App</button>
    </form>
  </div>
</div>
</body>
</html>
