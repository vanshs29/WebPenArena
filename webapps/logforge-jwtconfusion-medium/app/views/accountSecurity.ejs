<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Security — Huddle</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
      <span class="navbar-brand mb-0 h1">Huddle</span>
    </div>
  </nav>
  <div class="container">
    <div class="p-4 bg-white rounded-3 shadow-sm">
      <h1 class="h4 mb-3">Session security</h1>
      <table class="table">
        <tbody>
          <tr><th>Algorithm</th><td><%= header.alg %></td></tr>
          <tr><th>Key ID</th><td><%= header.kid || 'n/a' %></td></tr>
          <tr><th>Type</th><td><%= header.typ %></td></tr>
        </tbody>
      </table>
      <p class="text-muted">
        Huddle-issued session tokens are signed with our private key. For enterprise SSO
        integrations that need to verify Huddle-issued tokens independently, the corresponding
        public verification key is available for download.
      </p>
      <a href="/keys/verify.pem" class="btn btn-outline-secondary btn-sm">Download verification key</a>
    </div>
  </div>
</body>
</html>
