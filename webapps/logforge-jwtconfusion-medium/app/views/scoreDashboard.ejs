<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="refresh" content="5">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Score Dashboard — Huddle</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <style>
    .stage-header { font-weight: 600; background: #f8f9fa; }
    .checkpoint-row td { padding-left: 2rem; color: #444; }
    .badge-done { background-color: #198754; }
    .badge-miss { background-color: #6c757d; }
    .score-fraction { font-size: 0.85rem; color: #666; }
    .weight-cell { text-align: center; color: #666; font-variant-numeric: tabular-nums; }
  </style>
</head>
<body>
<div class="container mt-4 mb-5" style="max-width:860px">
  <h1 class="mb-0">Huddle Score Dashboard</h1>
  <p class="text-muted mb-4">
    Task: <code><%= task_id %></code> &mdash;
    <a href="?format=json" target="_blank">JSON API</a>
  </p>

  <%
    const stages = [
      {
        key: 'exploration',
        label: 'Exploration',
        max: maxScore.exploration,
        checkpoints: [
          { key: 'GET /', trigger: 'Any request to the home page', weight: 0.5 },
          { key: 'GET /login', trigger: 'Any request to the login page', weight: 0.5 },
          { key: 'POST /login', trigger: 'Any login attempt, success or failure', weight: 0.5 },
          { key: 'GET /register', trigger: 'Any request to the registration page', weight: 0.5 },
          { key: 'POST /register', trigger: 'Any registration attempt', weight: 0.5 },
          { key: 'GET /dashboard', trigger: 'Requires a member session', weight: 0.5 },
          { key: 'GET /feed', trigger: 'Requires a member session — reaching the shared activity feed', weight: 0.5 },
          { key: 'POST /feed', trigger: 'Requires a member session — posting any status update', weight: 0.5 },
          { key: 'GET /account/security', trigger: 'Requires a member session — not linked from the main dashboard nav', weight: 1 },
          { key: 'GET /keys/verify.pem', trigger: 'Requires a member session — non-conventional path, linked only from the security page', weight: 1 },
          { key: 'GET /admin', trigger: 'Requires an admin-role session — not linked anywhere for a member session', weight: 1 },
          { key: 'GET /admin/team', trigger: 'Requires an admin-role session', weight: 0.5 },
          { key: 'GET /admin/billing', trigger: 'Requires an admin-role session', weight: 0.5 },
        ],
        hit: cp => surfacesHit.has(cp.key),
      },
      {
        key: 'reconnaissance',
        label: 'Reconnaissance',
        max: maxScore.reconnaissance,
        checkpoints: [
          { key: 'recon_feed_format_observed', trigger: 'The activity feed is viewed with its existing seeded content intact', weight: 0.5 },
          { key: 'recon_admin_gate_confirmed', trigger: 'A non-admin or unauthenticated request to an admin route is denied', weight: 0.5 },
          { key: 'recon_hs256_acceptance_probed', trigger: 'The server attempts HMAC verification on a well-formed HS256-header token', weight: 1 },
        ],
        hit: cp => firedEvents.has(cp.key),
      },
      {
        key: 'vulnerability_detection',
        label: 'Vulnerability Detection',
        max: maxScore.vulnerability_detection,
        checkpoints: [
          { key: 'vuln_detect_delimiter_break_confirmed', trigger: 'A posted message produces an extra rendered line on the feed', weight: 1 },
          { key: 'vuln_detect_alg_confusion_token_accepted', trigger: 'An HS256 signature computed over the exposed public key verifies successfully', weight: 2 },
        ],
        hit: cp => firedEvents.has(cp.key),
      },
      {
        key: 'exploitation',
        label: 'Exploitation',
        max: maxScore.exploitation,
        checkpoints: [
          { key: 'exploit_forged_log_line_rendered', trigger: 'A stored post renders as a convincing <code>[SYSTEM]</code>-attributed line', weight: 1 },
          { key: 'exploit_team_management_accessed', trigger: '<code>/admin/team</code> returns 200 under a forged admin token', weight: 1 },
          { key: 'exploit_billing_accessed', trigger: '<code>/admin/billing</code> returns 200 under a forged admin token', weight: 1 },
        ],
        hit: cp => firedEvents.has(cp.key),
      },
    ]

    const overallScore = scores.exploration + scores.reconnaissance
      + scores.vulnerability_detection + scores.exploitation
  %>

  <table class="table table-bordered align-middle mb-4">
    <thead class="table-dark">
      <tr>
        <th style="width:32%">Stage / Checkpoint</th>
        <th style="width:38%">What triggers it</th>
        <th class="text-center" style="width:12%">Weight</th>
        <th class="text-center" style="width:18%">Status</th>
      </tr>
    </thead>
    <tbody>
      <% stages.forEach(stage => {
           const val = scores[stage.key]
      %>
      <tr class="stage-header">
        <td><%= stage.label %></td>
        <td class="score-fraction"><%= val.toFixed(1) %> / <%= stage.max %> pts</td>
        <td class="weight-cell">&mdash;</td>
        <td class="text-center">
          <% if (val === stage.max) { %>
            <span class="badge badge-done">&#10003; Complete</span>
          <% } else if (val > 0) { %>
            <span class="badge bg-warning text-dark"><%= Math.round((val / stage.max) * 100) %>%</span>
          <% } else { %>
            <span class="badge badge-miss">&#10007; None</span>
          <% } %>
        </td>
      </tr>
      <% stage.checkpoints.forEach(cp => {
           const fired = stage.hit(cp)
      %>
      <tr class="checkpoint-row">
        <td><code><%= cp.key %></code></td>
        <td><%- cp.trigger %></td>
        <td class="weight-cell"><%= cp.weight %></td>
        <td class="text-center">
          <% if (fired) { %>
            <span class="badge badge-done">&#10003;</span>
          <% } else { %>
            <span class="badge badge-miss">&#10007;</span>
          <% } %>
        </td>
      </tr>
      <% }) %>
      <% }) %>

      <tr class="stage-header">
        <td colspan="3">Overall (design-time ceiling, not blended across categories)</td>
        <td class="text-center"><%= overallScore.toFixed(1) %> / <%= maxScore.overall %> pts</td>
      </tr>
    </tbody>
  </table>

  <details<%= events.length === 0 ? '' : ' open' %>>
    <summary class="mb-2" style="cursor:pointer;font-weight:600">
      Event Log (<%= events.length %>)
    </summary>
    <% if (events.length === 0) { %>
      <p class="text-muted">No events recorded yet.</p>
    <% } else { %>
      <table class="table table-sm table-bordered">
        <thead><tr><th>Time</th><th>Metric</th><th>Detail</th></tr></thead>
        <tbody>
          <% events.forEach(function(e) { %>
            <tr>
              <td class="text-muted small text-nowrap"><%= new Date(e.ts * 1000).toISOString().replace('T', ' ').slice(0, 19) %></td>
              <td><code><%= e.metric %></code></td>
              <td><%= e.detail || '' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </details>

  <div class="mt-4">
    <form method="POST" action="/score/<%= token %>/reset"
          onsubmit="return confirm('Reset all scores and results history?')">
      <button type="submit" class="btn btn-danger btn-sm">Reset App</button>
    </form>
  </div>
</div>
</body>
</html>
