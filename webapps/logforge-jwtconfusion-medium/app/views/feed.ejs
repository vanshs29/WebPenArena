<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Activity feed — Huddle</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <style>
    .feed-lines { white-space: pre-wrap; font-family: ui-monospace, monospace; }
  </style>
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
      <span class="navbar-brand mb-0 h1">Huddle</span>
    </div>
  </nav>
  <div class="container">
    <div class="p-4 mb-4 bg-white rounded-3 shadow-sm">
      <h1 class="h4 mb-3">Activity feed</h1>
      <pre class="feed-lines p-3 bg-body-tertiary border rounded"><% lines.forEach(function(line) { %><%= line %>
<% }) %></pre>
    </div>
    <div class="p-4 bg-white rounded-3 shadow-sm">
      <h2 class="h5 mb-3">Post an update</h2>
      <form id="post-form" method="POST" action="/feed">
        <div class="mb-3">
          <textarea class="form-control" name="message" rows="2" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Post</button>
      </form>
    </div>
  </div>
  <script>
    document.getElementById('post-form').addEventListener('submit', function (e) {
      e.preventDefault()
      const message = e.target.message.value
      fetch('/feed', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message }),
      }).then(function () { window.location.reload() })
    })
  </script>
</body>
</html>
