<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>New Page — BillFold</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
  <nav class="navbar navbar-dark bg-dark mb-4"><div class="container"><a class="navbar-brand fw-bold" href="/">BillFold</a></div></nav>
  <div class="container">
    <h2 class="mb-3">Create a custom page</h2>
    <p class="text-muted">
      Custom pages are publicly viewable and can be embedded elsewhere &mdash; useful for a
      shared profile, note, or widget. HTML and CSS are rendered as submitted;
      <code>&lt;script&gt;</code> tags are removed before your page is stored.
    </p>
    <form id="pageForm">
      <div class="mb-3">
        <label class="form-label">Page HTML</label>
        <textarea id="htmlInput" name="html" class="form-control" rows="12"></textarea>
      </div>
      <button type="submit" class="btn btn-dark">Create page</button>
    </form>
    <p id="result" class="mt-3"></p>
  </div>
  <script>
    document.getElementById('pageForm').addEventListener('submit', async function (e) {
      e.preventDefault()
      const html = document.getElementById('htmlInput').value
      const res = await fetch('/pages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ html }),
      })
      if (res.ok) {
        const body = await res.json()
        document.getElementById('result').innerHTML =
          'Created: <a href="/pages/' + body.id + '">/pages/' + body.id + '</a>'
      } else {
        document.getElementById('result').textContent = 'Error creating page.'
      }
    })
  </script>
</body>
</html>
