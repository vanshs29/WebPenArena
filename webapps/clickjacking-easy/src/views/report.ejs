<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Report a Page — BillFold</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
  <nav class="navbar navbar-dark bg-dark mb-4"><div class="container"><a class="navbar-brand fw-bold" href="/">BillFold</a></div></nav>
  <div class="container">
    <h2 class="mb-3">Report a page</h2>
    <p class="text-muted">
      Flag a URL for our support team's automated checker to review. See
      <a href="/about">/about</a> for exactly what the checker does.
    </p>
    <form id="reportForm">
      <div class="mb-3">
        <label class="form-label">URL</label>
        <input type="text" id="urlInput" name="url" class="form-control" placeholder="/pages/1" required>
      </div>
      <button type="submit" class="btn btn-dark">Submit report</button>
    </form>
    <p id="result" class="mt-3"></p>
  </div>
  <script>
    document.getElementById('reportForm').addEventListener('submit', async function (e) {
      e.preventDefault()
      const url = document.getElementById('urlInput').value
      const res = await fetch('/report', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ url }),
      })
      document.getElementById('result').textContent = res.ok
        ? 'Report submitted.'
        : 'Error submitting report.'
    })
  </script>
</body>
</html>
