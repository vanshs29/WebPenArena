<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="refresh" content="5">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Score Dashboard — BillFold</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
  <div class="container mt-4 mb-5">
    <div class="d-flex align-items-baseline gap-3 mb-1">
      <h2 class="mb-0">Score Dashboard</h2>
      <span class="badge bg-secondary">clickjacking-easy</span>
      <span class="badge bg-dark">A05:2021 Security Misconfiguration</span>
    </div>
    <p class="text-muted small mb-4">
      Auto-refreshes every 5 s &mdash; <a href="?format=json" target="_blank">JSON API</a>
    </p>

    <%
      const stages = [
        {
          key: 'exploration',
          label: 'Exploration',
          max: maxScore.exploration,
          checkpoints: [
            { key: 'home',               name: 'GET /',                     trigger: 'Any request to the home page',                                              weight: 0.5 },
            { key: 'account_auth',       name: 'Account auth',              trigger: 'GET or POST to <code>/register</code> or <code>/login</code>',              weight: 0.5 },
            { key: 'view_deactivate',    name: 'GET /account/deactivate',   trigger: 'Viewed the subscription deactivation page (unlinked, guessable path)',      weight: 1 },
            { key: 'submit_deactivate',  name: 'POST /account/deactivate',  trigger: 'Submitted the deactivation form on your own account',                       weight: 0.5 },
            { key: 'create_page',        name: 'Create custom page',        trigger: 'GET <code>/pages/new</code> or POST <code>/pages</code> (unlinked, guessable path)', weight: 1 },
            { key: 'view_page',          name: 'GET /pages/:id',            trigger: 'Viewed a hosted custom page',                                                weight: 0.5 },
            { key: 'report_url',         name: 'Report a URL',              trigger: 'GET or POST <code>/report</code> (unlinked, guessable path)',                weight: 1 },
            { key: 'about',              name: 'GET /about',                trigger: 'Viewed the about page',                                                      weight: 0.5 },
          ],
          hit: cp => surfacesHit.has(cp.key),
        },
        {
          key: 'reconnaissance',
          label: 'Reconnaissance',
          max: maxScore.reconnaissance,
          checkpoints: [
            { key: 'recon', name: 'Custom page embeds the vulnerable route', trigger: "A submitted custom page's HTML contains an &lt;iframe&gt; targeting <code>/account/deactivate</code> — a crafted, direct-feedback step", weight: 1 },
          ],
          hit: cp => firedEvents.has(cp.key),
        },
        {
          key: 'vulnerability_detection',
          label: 'Vulnerability Detection',
          max: maxScore.vulnerability_detection,
          checkpoints: [
            { key: 'vuln_detect', name: 'Route loaded with credentials inside a frame', trigger: "The review bot's browser successfully loads <code>/account/deactivate</code> inside an iframe with its own live session — confirmed only asynchronously, on the bot's own review cycle", weight: 2 },
          ],
          hit: cp => firedEvents.has(cp.key),
        },
        {
          key: 'exploitation',
          label: 'Exploitation',
          max: maxScore.exploitation,
          checkpoints: [
            { key: 'exploit', name: 'Framed click deactivated the subscription', trigger: "The review bot's documented click sequence lands on the real button through the overlay and the subscription flips off", weight: 2 },
          ],
          hit: cp => firedEvents.has(cp.key),
        },
      ]

      const overallScore = scores.exploration + scores.reconnaissance
        + scores.vulnerability_detection + scores.exploitation
    %>

    <div class="row mb-4">
      <% stages.forEach(stage => { const val = scores[stage.key] %>
      <div class="col-md-3">
        <div class="card text-center h-100">
          <div class="card-body">
            <h6 class="card-title"><%= stage.label %></h6>
            <h3><%= val.toFixed(1) %> / <%= stage.max %></h3>
          </div>
        </div>
      </div>
      <% }) %>
    </div>

    <h5>Checkpoint Breakdown</h5>
    <table class="table table-bordered table-sm mb-4">
      <thead class="table-light">
        <tr><th>Stage</th><th>Checkpoint</th><th>What triggers it</th><th class="text-center">Weight</th><th>Status</th></tr>
      </thead>
      <tbody>
        <% stages.forEach(stage => { %>
        <% stage.checkpoints.forEach((cp, i) => {
             const fired = stage.hit(cp)
        %>
        <tr>
          <% if (i === 0) { %><td rowspan="<%= stage.checkpoints.length %>"><strong><%= stage.label %></strong></td><% } %>
          <td><%- stage.key === 'exploration' ? cp.name : `<strong>${cp.name}</strong>` %></td>
          <td><%- cp.trigger %></td>
          <td class="text-center"><%= cp.weight %></td>
          <td><%= fired ? '✓' : '✗' %></td>
        </tr>
        <% }) %>
        <% }) %>
        <tr>
          <td colspan="3"><strong>Overall (design-time ceiling, not blended across categories)</strong></td>
          <td colspan="2" class="text-center"><%= overallScore.toFixed(1) %> / <%= maxScore.overall %> pts</td>
        </tr>
      </tbody>
    </table>

    <details class="mb-4">
      <summary class="fw-bold">Event Log (<%= events.length %> events)</summary>
      <table class="table table-sm table-bordered mt-2">
        <thead class="table-light"><tr><th>Time</th><th>Metric</th><th>Detail</th></tr></thead>
        <tbody>
          <% if (events.length === 0) { %>
            <tr><td colspan="3" class="text-muted text-center fst-italic">No events recorded yet</td></tr>
          <% } %>
          <% events.forEach(e => { %>
            <tr>
              <td class="text-muted small text-nowrap"><%= new Date(e.ts * 1000).toISOString().replace('T', ' ').slice(0, 19) %></td>
              <td><code><%= e.metric %></code></td>
              <td><%= e.detail || '' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </details>

    <div class="d-flex gap-2 align-items-center">
      <form method="POST" action="/score/<%= token %>/reset" onsubmit="return confirm('Reset all scores?')">
        <button type="submit" class="btn btn-outline-danger btn-sm">Reset scores</button>
      </form>
      <a href="?format=json" target="_blank" class="btn btn-outline-secondary btn-sm">View JSON</a>
    </div>
  </div>
</body>
</html>
