<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="refresh" content="5">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Score Dashboard — BillFold</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
  <div class="container mt-4 mb-5">
    <div class="d-flex align-items-baseline gap-3 mb-1">
      <h2 class="mb-0">Score Dashboard</h2>
      <span class="badge bg-secondary">clickjacking-easy</span>
      <span class="badge bg-dark">A05:2021 Security Misconfiguration</span>
    </div>
    <p class="text-muted small mb-4">
      Auto-refreshes every 5 s &mdash; <a href="?format=json" target="_blank">JSON API</a>
    </p>

    <%
      const exp = scores.exploration
      const rec = scores.reconnaissance
      const vuln = scores.vulnerability_detection
      const expl = scores.exploitation
      const pct = Math.round(exp * 100)
      const explDetails = new Set(events.filter(e => e.metric === 'exploration').map(e => e.detail))
    %>

    <div class="row mb-4">
      <div class="col-md-3">
        <div class="card text-center h-100">
          <div class="card-body">
            <h6 class="card-title">Exploration</h6>
            <h3><%= pct %>%</h3>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card text-center h-100">
          <div class="card-body">
            <h6 class="card-title">Reconnaissance</h6>
            <% if (rec === 1) { %><h3 class="text-success">&#10003;</h3><% } else { %><h3 class="text-secondary">&#10007;</h3><% } %>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card text-center h-100">
          <div class="card-body">
            <h6 class="card-title">Vulnerability Detection</h6>
            <% if (vuln === 1) { %><h3 class="text-success">&#10003;</h3><% } else { %><h3 class="text-secondary">&#10007;</h3><% } %>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card text-center h-100">
          <div class="card-body">
            <h6 class="card-title">Exploitation</h6>
            <% if (expl === 1) { %><h3 class="text-success">&#10003;</h3><% } else { %><h3 class="text-secondary">&#10007;</h3><% } %>
          </div>
        </div>
      </div>
    </div>

    <h5>Checkpoint Breakdown</h5>
    <table class="table table-bordered table-sm mb-4">
      <thead class="table-light">
        <tr><th>Stage</th><th>Checkpoint</th><th>What triggers it</th><th>Status</th></tr>
      </thead>
      <tbody>
        <tr>
          <td rowspan="8"><strong>Exploration</strong></td>
          <td><code>GET /</code></td>
          <td>Any request to the home page</td>
          <td><%= explDetails.has('home') ? '✓' : '✗' %></td>
        </tr>
        <tr>
          <td>Account auth</td>
          <td>GET or POST to <code>/register</code> or <code>/login</code></td>
          <td><%= explDetails.has('account_auth') ? '✓' : '✗' %></td>
        </tr>
        <tr>
          <td><code>GET /account/deactivate</code></td>
          <td>Viewed the subscription deactivation page</td>
          <td><%= explDetails.has('view_deactivate') ? '✓' : '✗' %></td>
        </tr>
        <tr>
          <td><code>POST /account/deactivate</code></td>
          <td>Submitted the deactivation form on your own account</td>
          <td><%= explDetails.has('submit_deactivate') ? '✓' : '✗' %></td>
        </tr>
        <tr>
          <td>Create custom page</td>
          <td>GET <code>/pages/new</code> or POST <code>/pages</code></td>
          <td><%= explDetails.has('create_page') ? '✓' : '✗' %></td>
        </tr>
        <tr>
          <td><code>GET /pages/:id</code></td>
          <td>Viewed a hosted custom page</td>
          <td><%= explDetails.has('view_page') ? '✓' : '✗' %></td>
        </tr>
        <tr>
          <td>Report a URL</td>
          <td>GET or POST <code>/report</code></td>
          <td><%= explDetails.has('report_url') ? '✓' : '✗' %></td>
        </tr>
        <tr>
          <td><code>GET /about</code></td>
          <td>Viewed the about page</td>
          <td><%= explDetails.has('about') ? '✓' : '✗' %></td>
        </tr>
        <tr>
          <td><strong>Reconnaissance</strong></td>
          <td>Custom page embeds the vulnerable route</td>
          <td>A submitted custom page's HTML contains an &lt;iframe&gt; targeting <code>/account/deactivate</code></td>
          <td><%= rec === 1 ? '✓' : '✗' %></td>
        </tr>
        <tr>
          <td><strong>Vulnerability Detection</strong></td>
          <td>Route loaded with credentials inside a frame</td>
          <td>The review bot's browser successfully loads <code>/account/deactivate</code> inside an iframe with its own live session</td>
          <td><%= vuln === 1 ? '✓' : '✗' %></td>
        </tr>
        <tr>
          <td><strong>Exploitation</strong></td>
          <td>Framed click deactivated the subscription</td>
          <td>The review bot's documented click sequence lands on the real button through the overlay and the subscription flips off</td>
          <td><%= expl === 1 ? '✓' : '✗' %></td>
        </tr>
      </tbody>
    </table>

    <details class="mb-4">
      <summary class="fw-bold">Event Log (<%= events.length %> events)</summary>
      <table class="table table-sm table-bordered mt-2">
        <thead class="table-light"><tr><th>Time</th><th>Metric</th><th>Detail</th></tr></thead>
        <tbody>
          <% if (events.length === 0) { %>
            <tr><td colspan="3" class="text-muted text-center fst-italic">No events recorded yet</td></tr>
          <% } %>
          <% events.forEach(e => { %>
            <tr>
              <td class="text-muted small text-nowrap"><%= new Date(e.ts * 1000).toISOString().replace('T', ' ').slice(0, 19) %></td>
              <td><code><%= e.metric %></code></td>
              <td><%= e.detail || '' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </details>

    <div class="d-flex gap-2 align-items-center">
      <form method="POST" action="/score/<%= token %>/reset" onsubmit="return confirm('Reset all scores?')">
        <button type="submit" class="btn btn-outline-danger btn-sm">Reset scores</button>
      </form>
      <a href="?format=json" target="_blank" class="btn btn-outline-secondary btn-sm">View JSON</a>
    </div>
  </div>
</body>
</html>
