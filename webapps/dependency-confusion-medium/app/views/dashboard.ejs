<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard — Portstone</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
<%- include('layout') %>
<div class="container" style="max-width:800px">
  <h1 class="mb-4">Your Shipments</h1>
  <p class="text-muted">Signed in as <%= user.username %> (<%= user.email %>)</p>
  <table class="table table-bordered">
    <thead>
      <tr><th>Reference</th><th>Destination</th><th>Status</th></tr>
    </thead>
    <tbody>
      <% shipments.forEach(s => { %>
        <tr>
          <td><a href="/shipments/<%= s.id %>"><%= s.reference %></a></td>
          <td><%= s.destination %></td>
          <td><%= s.status %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
</body>
</html>
