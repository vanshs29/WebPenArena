<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Shipment — Portstone</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
<%- include('layout') %>
<div class="container" style="max-width:600px">
  <h1 class="mb-4"><%= shipment.reference %></h1>
  <dl class="row">
    <dt class="col-sm-4">Destination</dt>
    <dd class="col-sm-8"><%= shipment.destination %></dd>
    <dt class="col-sm-4">Status</dt>
    <dd class="col-sm-8"><%= shipment.status %></dd>
  </dl>
  <a class="btn btn-outline-secondary" href="/dashboard">Back to Dashboard</a>
</div>
</body>
</html>
