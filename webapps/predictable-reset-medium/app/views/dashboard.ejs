<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard — Foundry</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
<%- include('layout') %>
<div class="container" style="max-width:800px">
  <h1 class="mb-4">Dashboard</h1>
  <p class="text-muted">Signed in as <%= user.username %> (<%= user.email %>)</p>
  <div class="list-group">
    <% projects.forEach(project => { %>
      <a class="list-group-item list-group-item-action" href="/projects/<%= project.id %>">
        <%= project.name %>
        <% if (project.is_private) { %><span class="badge bg-secondary ms-2">Private</span><% } %>
      </a>
    <% }) %>
  </div>
</div>
</body>
</html>
