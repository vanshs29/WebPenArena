<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Reset password — Foundry</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
<div class="container mt-5" style="max-width:420px">
  <h1 class="mb-4">Reset password</h1>
  <form method="POST" action="/reset-password/confirm">
    <div class="mb-3">
      <label class="form-label" for="email">Email</label>
      <input class="form-control" type="email" id="email" name="email" required>
    </div>
    <div class="mb-3">
      <label class="form-label" for="token">Reset code</label>
      <input class="form-control" type="text" id="token" name="token" required>
    </div>
    <div class="mb-3">
      <label class="form-label" for="new_password">New password</label>
      <input class="form-control" type="password" id="new_password" name="new_password" required>
    </div>
    <button class="btn btn-primary" type="submit">Reset password</button>
  </form>
  <p class="mt-3"><a href="/forgot-password">Need a new code?</a></p>
</div>
</body>
</html>
