<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Forgot password — Foundry</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
<div class="container mt-5" style="max-width:420px">
  <h1 class="mb-4">Forgot password</h1>
  <p class="text-muted">Enter your account email and we'll generate a reset code.</p>
  <form method="POST" action="/forgot-password">
    <div class="mb-3">
      <label class="form-label" for="email">Email</label>
      <input class="form-control" type="email" id="email" name="email" required>
    </div>
    <button class="btn btn-primary" type="submit">Request reset</button>
  </form>
  <p class="mt-3"><a href="/reset-password">Already have a code?</a></p>
</div>
</body>
</html>
