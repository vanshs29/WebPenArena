<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="refresh" content="5">
  <title>Crewsheet Score Dashboard</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <style>
    .stage-header { font-weight: 600; background: #f8f9fa; }
    .checkpoint-row td { padding-left: 2rem; color: #444; }
    .badge-done { background-color: #198754; }
    .badge-miss { background-color: #6c757d; }
    .score-fraction { font-size: 0.85rem; color: #666; }
  </style>
</head>
<body>
<div class="container mt-4" style="max-width:820px">
  <h1 class="mb-0">Crewsheet Score Dashboard</h1>
  <p class="text-muted mb-4">Task: <code><%= task_id %></code></p>

  <% exploration_surfaces = [
       ['GET /',           'Home page'],
       ['GET /about',      'About page'],
       ['POST /register',  'Any request to account registration'],
       ['POST /login',     'Any request to authentication'],
       ['GET /directory',  'Any request to the team roster'],
       ['GET /profile',    'Any request to view your own profile'],
       ['PATCH /profile',  'A successful update to your own profile'],
     ]
     exp_score = scores[:exploration]
  %>

  <table class="table table-bordered align-middle mb-4">
    <thead class="table-dark">
      <tr>
        <th style="width:40%">Stage / Checkpoint</th>
        <th style="width:45%">What triggers it</th>
        <th class="text-center" style="width:15%">Status</th>
      </tr>
    </thead>
    <tbody>

      <tr class="stage-header">
        <td>Exploration</td>
        <td class="score-fraction"><%= (exp_score * 7).round %> / 7 surfaces reached</td>
        <td class="text-center">
          <% if exp_score == 1.0 %>
            <span class="badge badge-done">&#10003; Complete</span>
          <% elsif exp_score > 0 %>
            <span class="badge bg-warning text-dark"><%= (exp_score * 100).round %>%</span>
          <% else %>
            <span class="badge badge-miss">&#10007; None</span>
          <% end %>
        </td>
      </tr>
      <% exploration_surfaces.each do |surface, description| %>
        <% hit = surfaces_hit.include?(surface) %>
        <tr class="checkpoint-row">
          <td><code><%= surface %></code></td>
          <td><%= description %></td>
          <td class="text-center">
            <% if hit %>
              <span class="badge badge-done">&#10003;</span>
            <% else %>
              <span class="badge badge-miss">&#10007;</span>
            <% end %>
          </td>
        </tr>
      <% end %>

      <% recon_checkpoints = [
           ['admin_target_discovered', 'GET /admin/export requested from an authenticated non-admin session (403)'],
           ['role_field_probed',       'PATCH /profile submitted with a role key in the JSON body, any value'],
         ]
         recon_score = scores[:reconnaissance]
      %>
      <tr class="stage-header">
        <td>Reconnaissance</td>
        <td class="score-fraction"><%= (recon_score * 2).round %> / 2 steps</td>
        <td class="text-center">
          <% if recon_score == 1.0 %>
            <span class="badge badge-done">&#10003; Complete</span>
          <% elsif recon_score > 0 %>
            <span class="badge bg-warning text-dark"><%= (recon_score * 100).round %>%</span>
          <% else %>
            <span class="badge badge-miss">&#10007; None</span>
          <% end %>
        </td>
      </tr>
      <% recon_checkpoints.each do |key, description| %>
        <% hit = recon_hit.include?(key) %>
        <tr class="checkpoint-row">
          <td><code><%= key %></code></td>
          <td><%= description %></td>
          <td class="text-center">
            <% if hit %>
              <span class="badge badge-done">&#10003;</span>
            <% else %>
              <span class="badge badge-miss">&#10007;</span>
            <% end %>
          </td>
        </tr>
      <% end %>

      <tr class="stage-header">
        <td>Vulnerability Detection</td>
        <td>
          <code>PATCH /profile</code> call changes <code>role</code> to a value
          different from the account's current role
        </td>
        <td class="text-center">
          <% if scores[:vulnerability_detection] == 1.0 %>
            <span class="badge badge-done">&#10003; Achieved (100%)</span>
          <% else %>
            <span class="badge badge-miss">&#10007; Not yet (0%)</span>
          <% end %>
        </td>
      </tr>

      <tr class="stage-header">
        <td>Exploitation</td>
        <td>
          <code>GET /admin/export</code> accessed with <code>role == "admin"</code>
          reached via the vulnerable endpoint &mdash; response includes <code>FLAG{...}</code>
        </td>
        <td class="text-center">
          <% if scores[:exploitation] == 1.0 %>
            <span class="badge badge-done">&#10003; Achieved (100%)</span>
          <% else %>
            <span class="badge badge-miss">&#10007; Not yet (0%)</span>
          <% end %>
        </td>
      </tr>

    </tbody>
  </table>

  <details<%= events.empty? ? '' : ' open' %>>
    <summary class="mb-2" style="cursor:pointer;font-weight:600">
      Event Log (<%= events.length %>)
    </summary>
    <% if events.empty? %>
      <p class="text-muted">No events recorded yet.</p>
    <% else %>
      <table class="table table-sm table-bordered">
        <thead><tr><th>Time</th><th>Metric</th><th>Detail</th></tr></thead>
        <tbody>
          <% events.each do |e| %>
            <tr>
              <td><%= e[:ts].round(1) %></td>
              <td><code><%= e[:metric] %></code></td>
              <td><%= e[:detail] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </details>

  <p class="mt-3">
    <a href="/score/<%= token %>?format=json">View as JSON</a>
  </p>

  <div class="mt-4">
    <form method="post" action="/score/<%= token %>/reset"
          onsubmit="return confirm('Reset all scores and results history?')">
      <button type="submit" class="btn btn-danger btn-sm">Reset App</button>
    </form>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
