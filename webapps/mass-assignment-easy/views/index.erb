<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Crewsheet</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
<nav class="navbar navbar-expand navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand" href="/">Crewsheet</a>
    <div class="navbar-nav">
      <a class="nav-link" href="/about">About</a>
    </div>
  </div>
</nav>

<div class="container py-5">
  <div class="p-5 mb-4 bg-light rounded-3">
    <h1 class="display-5 fw-bold">Crewsheet</h1>
    <p class="col-md-8 fs-4">
      A lightweight internal team directory. Register an account, browse the roster,
      and keep your own profile up to date.
    </p>
  </div>

  <div class="row g-4">
    <div class="col-md-4">
      <h5>Register</h5>
      <p class="text-muted">
        Create an account with <code>POST /register</code> (JSON body: <code>name</code>,
        <code>email</code>, <code>password</code>).
      </p>
    </div>
    <div class="col-md-4">
      <h5>Directory</h5>
      <p class="text-muted">
        Once logged in, view the shared team roster at <code>GET /directory</code>.
      </p>
    </div>
    <div class="col-md-4">
      <h5>Your Profile</h5>
      <p class="text-muted">
        View your profile with <code>GET /profile</code> and update it with
        <code>PATCH /profile</code>.
      </p>
    </div>
  </div>
</div>
</body>
</html>
