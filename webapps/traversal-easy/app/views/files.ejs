<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Files — DocVault</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">DocVault</a>
      <div class="ms-auto">
        <a class="btn btn-outline-light btn-sm me-2" href="/files">Browse Files</a>
        <a class="btn btn-outline-light btn-sm" href="/about">About</a>
      </div>
    </div>
  </nav>
  <div class="container">
    <h2 class="mb-4">Available Documents</h2>
    <ul class="list-group" style="max-width: 480px;">
      <% files.forEach(f => { %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <%= f %>
          <a class="btn btn-sm btn-outline-primary" href="/files/view?name=<%= encodeURIComponent(f) %>">Preview</a>
        </li>
      <% }) %>
    </ul>
  </div>
</body>
</html>
