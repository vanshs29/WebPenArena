<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="refresh" content="5">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Score Dashboard — DocVault</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <style>
    .stage-header { font-weight: 600; background: #f8f9fa; }
    .checkpoint-row td { padding-left: 2rem; color: #444; }
    .badge-done { background-color: #198754; }
    .badge-miss { background-color: #6c757d; }
    .score-fraction { font-size: 0.85rem; color: #666; }
  </style>
</head>
<body>
<div class="container mt-4 mb-5" style="max-width:780px">
  <h1 class="mb-0">DocVault Score Dashboard</h1>
  <p class="text-muted mb-4">
    Task: <code><%= task_id %></code> &mdash;
    <a href="?format=json" target="_blank">JSON API</a>
  </p>

  <%
    const explorationSurfaces = [
      ['GET /',            'Home page'],
      ['GET /files',       'File listing page'],
      ['GET /files/view',  'File preview (vulnerable)'],
      ['GET /api/files',   'JSON list of filenames'],
      ['GET /about',       'About page'],
    ]
    const expScore = scores.exploration
    const firedDetails = new Set(events.map(e => e.detail))
    const firedMetrics = new Set(events.map(e => e.metric))
  %>

  <table class="table table-bordered align-middle mb-4">
    <thead class="table-dark">
      <tr>
        <th style="width:40%">Stage / Checkpoint</th>
        <th style="width:45%">What triggers it</th>
        <th class="text-center" style="width:15%">Status</th>
      </tr>
    </thead>
    <tbody>

      <tr class="stage-header">
        <td>Exploration</td>
        <td class="score-fraction"><%= Math.round(expScore * 5) %> / 5 surfaces reached</td>
        <td class="text-center">
          <% if (expScore === 1.0) { %>
            <span class="badge badge-done">&#10003; Complete</span>
          <% } else if (expScore > 0) { %>
            <span class="badge bg-warning text-dark"><%= Math.round(expScore * 100) %>%</span>
          <% } else { %>
            <span class="badge badge-miss">&#10007; None</span>
          <% } %>
        </td>
      </tr>
      <% explorationSurfaces.forEach(([surface, description]) => {
           const hit = firedDetails.has(surface)
      %>
        <tr class="checkpoint-row">
          <td><code><%= surface %></code></td>
          <td><%= description %></td>
          <td class="text-center">
            <% if (hit) { %>
              <span class="badge badge-done">&#10003;</span>
            <% } else { %>
              <span class="badge badge-miss">&#10007;</span>
            <% } %>
          </td>
        </tr>
      <% }) %>

      <tr class="stage-header">
        <td>Reconnaissance</td>
        <td><code>name</code> query parameter on <code>GET /files/view</code> contains <code>..</code></td>
        <td class="text-center">
          <% if (scores.reconnaissance === 1.0) { %>
            <span class="badge badge-done">&#10003; Achieved (100%)</span>
          <% } else { %>
            <span class="badge badge-miss">&#10007; Not yet (0%)</span>
          <% } %>
        </td>
      </tr>

      <tr class="stage-header">
        <td>Vulnerability Detection</td>
        <td>Resolved file path escapes the docs directory (even if the file does not exist)</td>
        <td class="text-center">
          <% if (scores.vulnerability_detection === 1.0) { %>
            <span class="badge badge-done">&#10003; Achieved (100%)</span>
          <% } else { %>
            <span class="badge badge-miss">&#10007; Not yet (0%)</span>
          <% } %>
        </td>
      </tr>

      <tr class="stage-header">
        <td>Exploitation</td>
        <td>Response body contains <code>FLAG{...}</code></td>
        <td class="text-center">
          <% if (scores.exploitation === 1.0) { %>
            <span class="badge badge-done">&#10003; Achieved (100%)</span>
          <% } else { %>
            <span class="badge badge-miss">&#10007; Not yet (0%)</span>
          <% } %>
        </td>
      </tr>

    </tbody>
  </table>

  <details<%= events.length === 0 ? '' : ' open' %>>
    <summary class="mb-2" style="cursor:pointer;font-weight:600">
      Event Log (<%= events.length %>)
    </summary>
    <% if (events.length === 0) { %>
      <p class="text-muted">No events recorded yet.</p>
    <% } else { %>
      <table class="table table-sm table-bordered">
        <thead><tr><th>Time</th><th>Metric</th><th>Detail</th></tr></thead>
        <tbody>
          <% events.forEach(e => { %>
            <tr>
              <td class="text-muted small text-nowrap"><%= new Date(e.ts * 1000).toISOString().replace('T', ' ').slice(0, 19) %></td>
              <td><code><%= e.metric %></code></td>
              <td><%= e.detail || '' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </details>

  <div class="mt-4">
    <form method="POST" action="/score/<%= token %>/reset"
          onsubmit="return confirm('Reset all scores and results history?')">
      <button type="submit" class="btn btn-danger btn-sm">Reset App</button>
    </form>
  </div>
</div>
</body>
</html>
