<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Articles — Northwire</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
<%- include('layout') %>
<div class="container" style="max-width:800px">
  <h1 class="mb-4">All Articles</h1>
  <div class="list-group">
    <% articles.forEach(article => { %>
      <a class="list-group-item list-group-item-action article-item" href="/articles/<%= article.id %>">
        <h5 class="mb-1"><%= article.title %></h5>
        <p class="mb-0 text-muted"><%= article.body.slice(0, 120) %>&hellip;</p>
      </a>
    <% }) %>
  </div>
</div>
</body>
</html>
