<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Northwire</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
<%- include('layout') %>
<div class="container" style="max-width:800px">
  <h1 class="mb-4">Northwire</h1>
  <p class="text-muted">Independent local news, updated daily.</p>
  <div class="list-group mb-4">
    <% articles.forEach(article => { %>
      <a class="list-group-item list-group-item-action" href="/articles/<%= article.id %>">
        <%= article.title %>
      </a>
    <% }) %>
  </div>
  <div id="recommended-widget" data-widget="recommended-stories"></div>
</div>
<script src="<%= widgetScriptUrl %>" async></script>
</body>
</html>
