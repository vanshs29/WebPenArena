<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Orders — Larkmoor</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
<%- include('layout') %>
<div class="container" style="max-width:800px">
  <h1 class="mb-4">Your Orders</h1>
  <table class="table table-striped">
    <thead>
      <tr><th>#</th><th>Description</th><th>Amount</th><th>Status</th></tr>
    </thead>
    <tbody>
      <% orders.forEach(o => { %>
        <tr>
          <td><%= o.id %></td>
          <td><%= o.description %></td>
          <td>$<%= o.amount.toFixed(2) %></td>
          <td>
            <span class="badge <%= o.status === 'refunded' ? 'bg-secondary' : 'bg-success' %>">
              <%= o.status %>
            </span>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
</body>
</html>
