<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Partners — Larkmoor</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
<div class="container mt-5 mb-5" style="max-width:760px">
  <h1 class="mb-3">Our Partners</h1>
  <p><a href="/">&larr; Back to Larkmoor</a></p>
  <p class="text-muted">Larkmoor integrates with the following B2B partners via the
    <a href="/docs/partner-api">Partner API</a>.</p>
  <table class="table table-striped">
    <thead><tr><th>Partner</th><th>Partner ID</th></tr></thead>
    <tbody>
      <% partners.forEach(p => { %>
        <tr>
          <td><%= p.name %></td>
          <td><code><%= p.partner_id %></code></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
</body>
</html>
