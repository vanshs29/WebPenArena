<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Billing — Driftline</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container"><span class="navbar-brand mb-0 h1">Driftline — Admin</span></div>
  </nav>
  <div class="container">
    <div class="p-4 bg-white rounded-3 shadow-sm">
      <h1 class="h4 mb-3">Billing</h1>
      <table class="table w-auto">
        <tbody>
          <tr><th scope="row">Plan</th><td><%= billing.plan %></td></tr>
          <tr><th scope="row">Card</th><td>•••• <%= billing.card_last4 %></td></tr>
          <tr><th scope="row">Next invoice</th><td><%= billing.next_invoice %></td></tr>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
