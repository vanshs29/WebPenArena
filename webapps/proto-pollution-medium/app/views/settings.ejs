<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Settings — Driftline</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container"><span class="navbar-brand mb-0 h1">Driftline</span></div>
  </nav>
  <div class="container">
    <div class="p-4 bg-white rounded-3 shadow-sm" style="max-width:640px">
      <h1 class="h4 mb-3">Settings</h1>
      <p class="text-muted">Update your theme and notification preferences below.</p>
      <pre class="bg-light p-3 rounded"><%= JSON.stringify(settings, null, 2) %></pre>
      <p class="small text-muted mb-0">
        Send a partial JSON body to <code>PATCH /api/settings</code> to update these values.
      </p>
    </div>
  </div>
</body>
</html>
