<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard — Fernhollow</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
<%- include('layout') %>
<div class="container" style="max-width:800px">
  <h1 class="mb-4">Dashboard</h1>
  <p class="text-muted">Signed in as <%= user.username %> (<%= user.email %>) &mdash; <%= user.title %>, <%= user.department %></p>
  <div class="list-group">
    <a class="list-group-item list-group-item-action" href="/directory">Employee Directory</a>
    <a class="list-group-item list-group-item-action" href="/profile">My Profile</a>
    <% if (user.role === 'admin') { %>
      <a class="list-group-item list-group-item-action" href="/admin/payroll">Payroll Report (Admin)</a>
    <% } %>
  </div>
</div>
</body>
</html>
