<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Payroll — Fernhollow</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
<%- include('layout') %>
<div class="container" style="max-width:800px">
  <h1 class="mb-4">Payroll Report</h1>
  <p class="text-muted">Confidential &mdash; Executive and HR access only.</p>
  <table class="table table-striped">
    <thead><tr><th>Name</th><th>Department</th><th>Title</th><th>Salary</th></tr></thead>
    <tbody>
      <% employees.forEach(e => { %>
        <tr>
          <td><%= e.username %></td>
          <td><%= e.department %></td>
          <td><%= e.title %></td>
          <td>$<%= e.salary.toLocaleString() %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
</body>
</html>
