<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Directory — Fernhollow</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
<%- include('layout') %>
<div class="container" style="max-width:800px">
  <h1 class="mb-4">Employee Directory</h1>
  <form class="row g-2 mb-4" method="GET" action="/directory/search">
    <div class="col-auto">
      <input class="form-control" type="text" name="department" placeholder="Department">
    </div>
    <div class="col-auto">
      <input class="form-control" type="text" name="title" placeholder="Title">
    </div>
    <div class="col-auto">
      <button class="btn btn-primary" type="submit">Search</button>
    </div>
  </form>
  <table class="table table-striped">
    <thead><tr><th>Name</th><th>Department</th><th>Title</th></tr></thead>
    <tbody>
      <% results.forEach(r => { %>
        <tr>
          <td><%= r.name %></td>
          <td><%= r.department %></td>
          <td><%= r.title %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
</body>
</html>
