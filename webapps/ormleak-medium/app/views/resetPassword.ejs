<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Reset password — Fernhollow</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
<div class="container mt-5" style="max-width:420px">
  <h1 class="mb-4">Reset password</h1>
  <p class="text-muted">Enter your account email to request a password reset.</p>
  <form id="request-form">
    <div class="mb-3">
      <label class="form-label" for="email">Email</label>
      <input class="form-control" type="email" id="email" name="email" required>
    </div>
    <button class="btn btn-primary" type="submit">Request reset</button>
  </form>
  <p class="mt-3"><a href="/reset-password/confirm">Already have a reset token?</a></p>
  <script>
    document.getElementById('request-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = new FormData(e.target);
      const res = await fetch('/reset-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: form.get('email') }),
      });
      const body = await res.json();
      alert(body.message || 'Request submitted');
    });
  </script>
</div>
</body>
</html>
