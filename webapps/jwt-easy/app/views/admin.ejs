<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin — DevBlog</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">DevBlog</a>
      <span class="navbar-text text-white">Admin panel</span>
    </div>
  </nav>
  <div class="container">
    <h1 class="mb-3">Post Moderation</h1>
    <table class="table table-bordered">
      <thead><tr><th>ID</th><th>Author</th><th>Title</th></tr></thead>
      <tbody>
        <% posts.forEach(p => { %>
          <tr><td><%= p.id %></td><td><%= p.author_id %></td><td><%= p.title %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>
</html>
