<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= poll.question %> — QuickPoll</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand" href="/">QuickPoll</a>
    </div>
  </nav>

  <div class="container" style="max-width: 480px">
    <a href="/" class="d-inline-block mb-3">&larr; Back to polls</a>
    <div class="card">
      <div class="card-body">
        <h1 class="h4 card-title"><%= poll.question %></h1>
        <form id="voteForm">
          <% poll.options.forEach((option, i) => { %>
            <div class="form-check mb-2">
              <input class="form-check-input" type="radio" name="optionIndex" id="option<%= i %>" value="<%= i %>" required>
              <label class="form-check-label" for="option<%= i %>"><%= option %></label>
            </div>
          <% }) %>
          <button class="btn btn-primary btn-sm mt-2" type="submit">Vote</button>
          <span id="voteStatus" class="ms-2 small text-muted"></span>
        </form>
      </div>
    </div>
  </div>

  <script>
    document.getElementById('voteForm').addEventListener('submit', async (ev) => {
      ev.preventDefault()
      const status = document.getElementById('voteStatus')
      const selected = document.querySelector('input[name="optionIndex"]:checked')
      if (!selected) return
      const res = await fetch(window.location.pathname + '/vote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ optionIndex: Number(selected.value) }),
      })
      status.textContent = res.ok ? 'Vote recorded.' : 'Vote failed — are you logged in?'
    })
  </script>
</body>
</html>
