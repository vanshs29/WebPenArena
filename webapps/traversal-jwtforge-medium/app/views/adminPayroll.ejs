<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Payroll — Ledger</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container"><span class="navbar-brand mb-0 h1">Ledger — Payroll</span></div>
  </nav>
  <div class="container">
    <div class="p-4 bg-white rounded-3 shadow-sm">
      <h1 class="h4 mb-3">Salary Table</h1>
      <table class="table">
        <thead><tr><th>Username</th><th>Salary</th></tr></thead>
        <tbody>
          <% salaries.forEach(function(s) { %>
            <tr><td><%= s.username %></td><td>$<%= s.salary %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
