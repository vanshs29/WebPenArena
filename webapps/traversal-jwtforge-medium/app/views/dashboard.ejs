<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard — Ledger</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container"><span class="navbar-brand mb-0 h1">Ledger</span></div>
  </nav>
  <div class="container">
    <div class="p-4 bg-white rounded-3 shadow-sm">
      <h1 class="h4 mb-3">Your Expense Reports</h1>
      <table class="table">
        <thead><tr><th>Amount</th><th>Description</th><th>Receipt</th></tr></thead>
        <tbody>
          <% expenses.forEach(function(e) { %>
            <tr>
              <td>$<%= e.amount.toFixed(2) %></td>
              <td><%= e.description %></td>
              <td><a href="/receipts?file=<%= encodeURIComponent(e.receipt_filename) %>"><%= e.receipt_filename %></a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
