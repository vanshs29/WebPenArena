<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Redemption History — Vaultly</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
<div class="container mt-5" style="max-width:640px">
  <h1>Redemption History</h1>
  <table class="table">
    <thead><tr><th>Code</th><th>Idempotency Key</th><th>Status</th></tr></thead>
    <tbody>
      <% entries.forEach(e => { %>
        <tr>
          <td><%= e.code %></td>
          <td><code><%= e.idempotency_key %></code></td>
          <td><%= e.status %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <a class="btn btn-primary" href="/wallet">Back to Wallet</a>
</div>
</body>
</html>
