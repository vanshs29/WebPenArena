<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Store — Vaultly</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
<div class="container mt-5" style="max-width:640px">
  <h1>Store</h1>
  <div class="row g-3">
    <% items.forEach(item => { %>
      <div class="col-12 col-sm-6">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title"><%= item.name %></h5>
            <p class="card-text">$<%= item.price.toFixed(2) %></p>
            <form method="POST" action="/store/purchase">
              <input type="hidden" name="item_id" value="<%= item.id %>">
              <button class="btn btn-primary btn-sm" type="submit">Purchase</button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
  <a class="btn btn-link mt-3" href="/wallet">Back to Wallet</a>
</div>
</body>
</html>
