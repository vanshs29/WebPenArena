<!DOCTYPE html>
<html lang="en">
<head>
  <title>Import Settings — Thornfield</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/sidebar', { active: 'settings' }) %>
    <h2>Import settings</h2>
    <p class="text-muted">Paste the settings bundle you exported from your previous helpdesk.
      Thornfield will apply routing and notification preferences from it to this workspace.</p>
    <form id="import-form">
      <textarea name="data" class="form-control" rows="8" placeholder='{"theme":"dark"}'></textarea>
      <button type="submit" class="btn tf-btn-primary text-white mt-3">Import</button>
      <div id="import-result" class="mt-3"></div>
    </form>
  <%- include('partials/sidebar-close') %>
  <script>
    document.getElementById('import-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = new FormData(e.target);
      const res = await fetch('/settings/import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ data: form.get('data') }),
      });
      const body = await res.json().catch(() => ({}));
      document.getElementById('import-result').textContent = res.ok ? 'Imported.' : (body.error || 'Import failed');
    });
  </script>
</body>
</html>
