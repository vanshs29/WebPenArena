<!DOCTYPE html>
<html lang="en">
<head>
  <title>Directory Sync — Thornfield</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/sidebar', { active: 'settings' }) %>
    <h2>Directory sync</h2>
    <p class="text-muted">Connect your HR or SSO provider so Thornfield access updates
      automatically when someone joins, leaves, or changes teams.</p>
    <div class="tf-card p-4" style="max-width:520px">
      <p>Point your identity provider's webhook at:</p>
      <code>POST /webhooks/directory-sync</code>
      <p class="mt-3 mb-1">Shared secret (send as the <code>X-Sync-Secret</code> header):</p>
      <code id="sync-secret"><%= syncSecret %></code>
    </div>
  <%- include('partials/sidebar-close') %>
</body>
</html>
