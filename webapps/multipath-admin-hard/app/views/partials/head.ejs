<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<style>
  :root {
    --tf-navy: #1f3b45;
    --tf-teal: #2a5c6b;
    --tf-amber: #d98e3a;
    --tf-bg: #f6f8f7;
  }
  body { background: var(--tf-bg); color: #223; }
  .tf-navbar { background: var(--tf-navy); }
  .tf-navbar .navbar-brand { color: #fff; font-weight: 600; letter-spacing: 0.02em; }
  .tf-sidebar { background: #fff; border-right: 1px solid #e1e6e5; min-height: calc(100vh - 56px); }
  .tf-sidebar a { color: #445; text-decoration: none; display: block; padding: 0.55rem 1rem; border-radius: 6px; }
  .tf-sidebar a:hover, .tf-sidebar a.active { background: var(--tf-teal); color: #fff; }
  .tf-btn-primary { background: var(--tf-teal); border-color: var(--tf-teal); }
  .tf-btn-primary:hover { background: var(--tf-navy); border-color: var(--tf-navy); }
  .tf-hero { background: linear-gradient(135deg, var(--tf-navy), var(--tf-teal)); color: #fff; }
  .tf-card { border: 1px solid #e1e6e5; border-radius: 10px; }
  .tf-badge-open { background: var(--tf-amber); }
</style>
