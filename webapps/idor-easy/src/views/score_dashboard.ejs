<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Score Dashboard — NoteNest</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <meta http-equiv="refresh" content="5">
  <style>
    .stage-header { font-weight: 600; background: #f8f9fa; }
    .checkpoint-row td { padding-left: 2rem; color: #444; }
    .badge-done { background-color: #198754; }
    .badge-miss { background-color: #6c757d; }
    .score-fraction { font-size: 0.85rem; color: #666; }
    .weight-cell { text-align: center; color: #666; font-variant-numeric: tabular-nums; }
  </style>
</head>
<body class="bg-light">
  <div class="container mt-4 mb-5" style="max-width:900px">

    <div class="d-flex align-items-baseline gap-3 mb-1">
      <h2 class="mb-0">Score Dashboard</h2>
      <span class="badge bg-secondary">idor-notes-easy</span>
      <span class="badge bg-dark">A01:2021 Broken Access Control</span>
    </div>
    <p class="text-muted small mb-4">
      Auto-refreshes every 5 s &mdash;
      <a href="?format=json" target="_blank">JSON API</a>
    </p>

    <%
      const stages = [
        {
          key: 'exploration',
          label: 'Exploration',
          max: maxScore.exploration,
          checkpoints: [
            { key: 'GET /',              trigger: 'Visited home page',                                   weight: 0.5 },
            { key: 'POST /login',        trigger: 'Submitted login form / API',                           weight: 0.5 },
            { key: 'POST /register',     trigger: 'Registered a new account',                             weight: 0.5 },
            { key: 'GET /notes',         trigger: 'Accessed notes page (auth required)',                  weight: 0.5 },
            { key: 'GET /api/notes',     trigger: 'Queried notes list API (unlinked, guessable path)',    weight: 1 },
            { key: 'GET /api/notes/:id', trigger: 'Queried single note by ID (unlinked, guessable path)', weight: 1 },
            { key: 'POST /api/notes',    trigger: 'Created a note via API (unlinked, guessable path)',    weight: 1 },
            { key: 'GET /admin',         trigger: 'Attempted admin panel (unlinked, guessable path)',     weight: 1 },
          ],
          hit: cp => surfacesHit.has(cp.key),
        },
        {
          key: 'reconnaissance',
          label: 'Reconnaissance',
          max: maxScore.reconnaissance,
          checkpoints: [
            { key: 'recon', trigger: 'Retrieved own note by numeric ID — sequential ID pattern identified', weight: 1 },
          ],
          hit: cp => firedEvents.has(cp.key),
        },
        {
          key: 'vulnerability_detection',
          label: 'Vulnerability Detection',
          max: maxScore.vulnerability_detection,
          checkpoints: [
            { key: 'vuln_detect', trigger: "GET /api/notes/:id returned another user's note (no 403 — confirmed broken access control)", weight: 2 },
          ],
          hit: cp => firedEvents.has(cp.key),
        },
        {
          key: 'exploitation',
          label: 'Exploitation',
          max: maxScore.exploitation,
          checkpoints: [
            { key: 'exploit', trigger: 'GET /api/notes/1 returned admin\'s private "Deployment Keys" note', weight: 2 },
          ],
          hit: cp => firedEvents.has(cp.key),
        },
      ]

      const overallScore = scores.exploration + scores.reconnaissance
        + scores.vulnerability_detection + scores.exploitation
    %>

    <table class="table table-bordered align-middle mb-4">
      <thead class="table-dark">
        <tr>
          <th style="width:32%">Stage / Checkpoint</th>
          <th style="width:38%">What triggers it</th>
          <th class="text-center" style="width:12%">Weight</th>
          <th class="text-center" style="width:18%">Status</th>
        </tr>
      </thead>
      <tbody>
        <% stages.forEach(stage => {
             const val = scores[stage.key]
        %>
        <tr class="stage-header">
          <td><%= stage.label %></td>
          <td class="score-fraction"><%= val.toFixed(1) %> / <%= stage.max %> pts</td>
          <td class="weight-cell">&mdash;</td>
          <td class="text-center">
            <% if (val === stage.max) { %>
              <span class="badge badge-done">&check; Complete</span>
            <% } else if (val > 0) { %>
              <span class="badge bg-warning text-dark"><%= Math.round((val / stage.max) * 100) %>%</span>
            <% } else { %>
              <span class="badge badge-miss">&cross; None</span>
            <% } %>
          </td>
        </tr>
        <% stage.checkpoints.forEach(cp => {
             const fired = stage.hit(cp)
        %>
        <tr class="checkpoint-row">
          <td><code><%= cp.key %></code></td>
          <td><%= cp.trigger %></td>
          <td class="weight-cell"><%= cp.weight %></td>
          <td class="text-center">
            <% if (fired) { %>
              <span class="badge badge-done">&check;</span>
            <% } else { %>
              <span class="badge badge-miss">&cross;</span>
            <% } %>
          </td>
        </tr>
        <% }) %>
        <% }) %>

        <tr class="stage-header">
          <td colspan="3">Overall (design-time ceiling, not blended across categories)</td>
          <td class="text-center"><%= overallScore.toFixed(1) %> / <%= maxScore.overall %> pts</td>
        </tr>
      </tbody>
    </table>

    <div class="d-flex align-items-center justify-content-between mb-2">
      <h5 class="mb-0">Event Log</h5>
      <span class="text-muted small"><%= events.length %> event<%= events.length !== 1 ? 's' : '' %> recorded</span>
    </div>
    <table class="table table-sm table-bordered table-hover">
      <thead class="table-dark">
        <tr><th>Time</th><th>Metric</th><th>Detail</th></tr>
      </thead>
      <tbody>
        <% if (events.length === 0) { %>
          <tr><td colspan="3" class="text-muted text-center fst-italic">No events recorded yet</td></tr>
        <% } %>
        <% events.forEach(e => { %>
          <tr>
            <td class="text-muted small text-nowrap"><%= new Date(e.ts * 1000).toISOString().replace('T',' ').slice(0,19) %></td>
            <td><code><%= e.metric %></code></td>
            <td><%= e.detail || '' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="d-flex gap-2 mt-3 align-items-center">
      <form method="POST" action="/score/<%= token %>/reset" onsubmit="return confirm('Reset all scores and invalidate tokens?')">
        <button type="submit" class="btn btn-outline-danger btn-sm">Reset scores</button>
      </form>
      <a href="?format=json" target="_blank" class="btn btn-outline-secondary btn-sm">View JSON</a>
    </div>

  </div>
</body>
</html>
