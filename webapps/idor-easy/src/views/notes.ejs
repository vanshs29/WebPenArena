<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>My Notes — NoteNest</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">NoteNest</a>
      <div class="ms-auto">
        <span class="text-light me-3"><%= user.email %></span>
        <a class="btn btn-outline-light btn-sm" href="/logout">Logout</a>
      </div>
    </div>
  </nav>
  <div class="container">
    <h2 class="mb-4">My Notes</h2>
    <% if (notes.length === 0) { %>
      <p class="text-muted">No notes yet. Use the API to create one.</p>
    <% } else { %>
      <div class="row">
        <% notes.forEach(note => { %>
          <div class="col-md-4 mb-3">
            <div class="card h-100">
              <div class="card-body">
                <h5 class="card-title"><%= note.title %></h5>
                <p class="card-text text-muted"><%= note.content %></p>
                <small class="text-muted">ID: <%= note.id %> <% if (note.is_private) { %> &bull; Private<% } %></small>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</body>
</html>
