<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tickets — Oakmere</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body>
<nav class="navbar navbar-expand navbar-light bg-light mb-4">
  <div class="container" style="max-width:800px">
    <a class="navbar-brand" href="/tickets">Oakmere</a>
  </div>
</nav>
<div class="container" style="max-width:800px">
  <h1 class="mb-3">Your Tickets</h1>
  <p class="text-muted">Signed in as <%= user.email %></p>

  <table class="table table-striped mb-4">
    <thead><tr><th>ID</th><th>Subject</th></tr></thead>
    <tbody>
      <% tickets.forEach(t => { %>
        <tr><td><%= t.id %></td><td><%= t.subject %></td></tr>
      <% }) %>
      <% if (tickets.length === 0) { %>
        <tr><td colspan="2" class="text-muted">No tickets yet.</td></tr>
      <% } %>
    </tbody>
  </table>

  <h2 class="h5">File a new ticket</h2>
  <form method="POST" action="/tickets" class="mb-4">
    <div class="mb-3">
      <label class="form-label" for="subject">Subject</label>
      <input class="form-control" type="text" id="subject" name="subject" required>
    </div>
    <div class="mb-3">
      <label class="form-label" for="body">Body</label>
      <textarea class="form-control" id="body" name="body" rows="3" required></textarea>
    </div>
    <button class="btn btn-primary" type="submit">Submit</button>
  </form>

  <h2 class="h5">Look up a ticket by ID</h2>
  <form method="GET" action="/tickets/lookup" class="d-flex" style="max-width:300px">
    <input class="form-control me-2" type="number" name="ticket_id" placeholder="Ticket ID" required>
    <button class="btn btn-outline-secondary" type="submit">Look up</button>
  </form>
</div>
</body>
</html>
